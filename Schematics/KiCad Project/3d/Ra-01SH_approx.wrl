#VRML V2.0 utf8
# Mechanical visualization model for Ai-Thinker Ra-01SH.
# Dimensions are approximate and expressed in millimetres; the footprint applies
# the KiCad VRML conversion scale. Use the datasheet/footprint for fabrication.

DEF PCB_APP Appearance { material Material { diffuseColor 0.05 0.28 0.13 } }
DEF METAL_APP Appearance { material Material { diffuseColor 0.72 0.74 0.76  specularColor 0.25 0.25 0.25 } }
DEF GOLD_APP Appearance { material Material { diffuseColor 0.85 0.60 0.08  specularColor 0.35 0.25 0.05 } }
DEF DARK_APP Appearance { material Material { diffuseColor 0.06 0.06 0.06 } }

Transform { translation 0 0 0.55 children [ Shape { appearance USE PCB_APP geometry Box { size 16 17 1.1 } } ] }
Transform { translation -0.7 1.0 1.55 children [ Shape { appearance USE METAL_APP geometry Box { size 10.8 10.2 0.9 } } ] }

# I-PEX/U.FL-compatible coax socket. In the KiCad top render this appears on
# the board-interior/lower side of U8, matching the accepted assembly preview.
Transform { translation 2.8 -5.8 1.45 children [ Shape { appearance USE GOLD_APP geometry Box { size 3.1 3.1 0.7 } } ] }
Transform { translation 2.8 -5.8 2.15 rotation 1 0 0 1.570796 children [ Shape { appearance USE GOLD_APP geometry Cylinder { radius 1.35 height 1.0 } } ] }
Transform { translation 2.8 -5.8 2.50 rotation 1 0 0 1.570796 children [ Shape { appearance USE DARK_APP geometry Cylinder { radius 0.52 height 1.1 } } ] }

# Castellated edge contacts.
Transform { translation -7.75 -7 0.72 children [ Shape { appearance USE GOLD_APP geometry Box { size 0.50 1.2 0.18 } } ] }
Transform { translation -7.75 -5 0.72 children [ Shape { appearance USE GOLD_APP geometry Box { size 0.50 1.2 0.18 } } ] }
Transform { translation -7.75 -3 0.72 children [ Shape { appearance USE GOLD_APP geometry Box { size 0.50 1.2 0.18 } } ] }
Transform { translation -7.75 -1 0.72 children [ Shape { appearance USE GOLD_APP geometry Box { size 0.50 1.2 0.18 } } ] }
Transform { translation -7.75 1 0.72 children [ Shape { appearance USE GOLD_APP geometry Box { size 0.50 1.2 0.18 } } ] }
Transform { translation -7.75 3 0.72 children [ Shape { appearance USE GOLD_APP geometry Box { size 0.50 1.2 0.18 } } ] }
Transform { translation -7.75 5 0.72 children [ Shape { appearance USE GOLD_APP geometry Box { size 0.50 1.2 0.18 } } ] }
Transform { translation -7.75 7 0.72 children [ Shape { appearance USE GOLD_APP geometry Box { size 0.50 1.2 0.18 } } ] }
Transform { translation 7.75 -7 0.72 children [ Shape { appearance USE GOLD_APP geometry Box { size 0.50 1.2 0.18 } } ] }
Transform { translation 7.75 -5 0.72 children [ Shape { appearance USE GOLD_APP geometry Box { size 0.50 1.2 0.18 } } ] }
Transform { translation 7.75 -3 0.72 children [ Shape { appearance USE GOLD_APP geometry Box { size 0.50 1.2 0.18 } } ] }
Transform { translation 7.75 -1 0.72 children [ Shape { appearance USE GOLD_APP geometry Box { size 0.50 1.2 0.18 } } ] }
Transform { translation 7.75 1 0.72 children [ Shape { appearance USE GOLD_APP geometry Box { size 0.50 1.2 0.18 } } ] }
Transform { translation 7.75 3 0.72 children [ Shape { appearance USE GOLD_APP geometry Box { size 0.50 1.2 0.18 } } ] }
Transform { translation 7.75 5 0.72 children [ Shape { appearance USE GOLD_APP geometry Box { size 0.50 1.2 0.18 } } ] }
Transform { translation 7.75 7 0.72 children [ Shape { appearance USE GOLD_APP geometry Box { size 0.50 1.2 0.18 } } ] }
